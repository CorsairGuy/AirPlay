<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Обезличенный fixture SETUP потока AirPlay 2 (тип 96), не захват устройства.
  Поля и длины: shairport-sync 5.5.2 rtsp.c handle_setup_2 (строки 2766-2920,
  shk обязан быть 32 байта; sr/spf/ct в том же дескрипторе) и UxPlay
  534e2cc0 lib/raop_handlers.h (тип 96, ct/spf/sr, ответ dataPort+controlPort).
  Ключ — временный нулевой, PIN/ID устройства отсутствуют.
-->
<plist version="1.0">
<dict>
  <key>streams</key>
  <array>
    <dict>
      <key>type</key>
      <integer>96</integer>
      <key>shk</key>
      <data>AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</data>
      <key>ct</key>
      <integer>1</integer>
      <key>ss</key>
      <integer>16</integer>
      <key>sr</key>
      <integer>44100</integer>
      <key>spf</key>
      <integer>352</integer>
      <key>ch</key>
      <integer>2</integer>
      <key>controlPort</key>
      <integer>6000</integer>
    </dict>
  </array>
</dict>
</plist>
